# Voice Agent System - API Keys Configuration
# Copy this file to .env and add your actual API keys

# OpenAI API Key (for LLM-based improvements and farmer persona generation)
OPENAI_API_KEY=your_openai_api_key_here

# Deepgram API Key (for speech-to-text transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API Key (for text-to-speech generation)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Optional: Specific voice IDs for different languages/accents
ELEVENLABS_HINDI_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_ENGLISH_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# System Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO